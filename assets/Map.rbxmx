        <Item class="Script" referent="2886">
          <Properties>
            <string name="Name">sun</string>
            <BinaryString name="AttributesSerialize" />
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="Disabled">false</bool>
            <UniqueId name="HistoryId">5deeb96852dc8b290ae72d96000040a7</UniqueId>
            <ContentId name="LinkedSource">
              <null />
            </ContentId>
            <token name="RunContext">0</token>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{D7FE2E98-74D7-4EC5-8959-D350550EF474}</string>
            <string name="Source"><![CDATA[
local RunService = game:GetService("RunService")

local sun = script.Parent
local ROTATION_SPEED = 60

local startPivot = sun:GetPivot()
local angle = 0

RunService.Heartbeat:Connect(function(deltaTime)
	angle += math.rad(ROTATION_SPEED) * deltaTime

	-- Paikutin na parang gulong sa local Z-axis
	sun:PivotTo(
		startPivot * CFrame.Angles(0, 0, angle)
	)
end)
]]></string>
            <int64 name="SourceAssetId">-1</int64>
                  <UniqueId name="UniqueId">3fc9cd6bcab384410aece30d0000eb0d</UniqueId>
          </Properties>
