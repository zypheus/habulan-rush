          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{58AAED2F-4AF6-441D-846C-377FE90533C1}</string>
          <string name="Source"><![CDATA[
local RunService = game:GetService("RunService")

local tail = script.Parent
local startPivot = tail:GetPivot()

local speed = 3
local maxAngle = math.rad(15)

RunService.Heartbeat:Connect(function()
	local t = os.clock()
	local sway = math.sin(t * speed) * maxAngle

	tail:PivotTo(
		startPivot * CFrame.Angles(0, 0, sway)
	)
end)
]]></string>
          <int64 name="SourceAssetId">-1</int64>
              <UniqueId name="UniqueId">4c3c36aa5bebc3c70aeba43300007fa0</UniqueId>
        </Properties>
