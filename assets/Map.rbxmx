      <Item class="Script" referent="2881">
        <Properties>
          <string name="Name">conveyorbelt</string>
          <BinaryString name="AttributesSerialize" />
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="Disabled">false</bool>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <ContentId name="LinkedSource">
            <null />
          </ContentId>
          <token name="RunContext">0</token>
          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{FA41EE2A-80A9-4558-9AFE-B3A765267E52}</string>
          <string name="Source">local TweenService = game:GetService("TweenService")
local ConveyorBelt = script.Parent
local Speed = 30
local texture = ConveyorBelt.Texture

ConveyorBelt.AssemblyLinearVelocity = ConveyorBelt.CFrame.LookVector * Speed

local info = TweenInfo.new(60, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1)
local tween = TweenService:Create(texture, info, {OffsetStudsU = Speed * 60})
tween:Play()</string>
          <int64 name="SourceAssetId">-1</int64>
              <UniqueId name="UniqueId">3fc9cd6bcab384410aece30d0000a095</UniqueId>
        </Properties>
      </Item>
    </Item>
