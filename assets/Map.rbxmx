              <null />
            </ContentId>
            <token name="RunContext">0</token>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{A64E93EA-AB9F-482E-B629-EA8704EB7725}</string>
            <string name="Source"><![CDATA[
local RunService = game:GetService("RunService")

local base = script.Parent

-- Smooth flag settings
local N, AMP, SPEED, WAVELEN = 160, 1.0, 3.0, 0.15

local old = workspace:FindFirstChild("WavingFlag")
if old then
	old:Destroy()
end

-- Get the original flag decals
local decals = {}

for _, d in ipairs(base:GetChildren()) do
	if d:IsA("Decal") then
		table.insert(decals, {
			face = d.Face,
			image = d.Texture
		})
	end
end

local size = base.Size
local stripW = size.X / N
local strips = {}

local model = Instance.new("Model")
model.Name = "WavingFlag"
model.Parent = workspace

-- Create flag strips
for i = 1, N do
	local p = Instance.new("Part")
	p.Name = "Strip" .. i
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(40, 40, 40)
	p.Size = Vector3.new(stripW + 0.01, size.Y, 0.02)

	for _, d in ipairs(decals) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = d.face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 100
		gui.LightInfluence = 0
		gui.Parent = p

		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundTransparency = 1
		frame.ClipsDescendants = true
		frame.Parent = gui

		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.BorderSizePixel = 0
		img.Image = d.image
		img.ScaleType = Enum.ScaleType.Stretch
		img.Size = UDim2.fromScale(N, 1)

		local index = N - i
		img.Position = UDim2.fromScale(-index, 0)
		img.Parent = frame
	end

	p.Parent = model

	strips[i] = {
		part = p,
		x = -size.X / 2 + (i - 0.5) * stripW,
		index = i
	}
end

-- Hide the original flag without changing its position
base.Transparency = 1
base.CanCollide = false

for _, d in ipairs(base:GetChildren()) do
	if d:IsA("Decal") then
		d.Transparency = 1
	end
end

-- Continuous smooth wave animation
local connection

connection = RunService.Heartbeat:Connect(function()
	if not base.Parent or not model.Parent then
		connection:Disconnect()
		return
	end

	local t = os.clock() * SPEED

	for i, s in ipairs(strips) do
		local phase = (i - 1) * WAVELEN

		-- Preserve the original wave formula
		local strength = ((N - i) / (N - 1)) * AMP

		local wave = (
			math.sin(t + phase)
				+ math.sin(t * 1.5 - (i - 1) * 0.1) * 0.3
		) * strength

		-- Calculate the next strip's wave consistently
		local nextPhase = i * WAVELEN

		local nextStrength =
			((N - math.min(i + 1, N)) / (N - 1)) * AMP

		local nextWave = (
			math.sin(t + nextPhase)
				+ math.sin(t * 1.5 - i * 0.1) * 0.3
		) * nextStrength

		local tilt = math.atan2(
			nextWave - wave,
			stripW
		) * 0.5

		-- Keep the original position and orientation formula
		s.part.CFrame =
			base.CFrame
			* CFrame.new(s.x, 0, wave)
			* CFrame.Angles(0, tilt, 0)
	end
end)
]]></string>
