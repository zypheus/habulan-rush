		cooldown = 18,
		duration = 4, -- decoy active seconds
		range    = 0,
		params   = { breakLock = true },
		tell     = { vfx = "SmokePuff",  sfx = "Psssh" },
		weakness = "Decoy has no stamina and runs in a straight line",
		counterCondition = "Taya locks onto or pounces the decoy",
	},
	RS_03 = {
		id       = "RS_03",
