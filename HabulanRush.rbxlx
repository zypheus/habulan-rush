			starLife = 0.5, -- [SD] impact star particle lifetime (s)
			starSpeedMin = 6, -- [SD] impact star speed low (studs/s)
			starSpeedMax = 14, -- [SD] impact star speed high (studs/s)
			impactRingTime = 0.25, -- [SD] impact ring grow/fade (s)
