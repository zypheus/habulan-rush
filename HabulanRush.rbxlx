fill.Size = UDim2.fromScale(1, 1) -- corrected on first attribute read
fill.BackgroundColor3 = COL_FILL_OK
fill.BorderSizePixel = 0
fill.Parent = barBg
corner(fill, 4)

local pct = Instance.new("TextLabel")
